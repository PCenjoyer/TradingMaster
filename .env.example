# Скопируйте файл в .env и замените значения. Сам .env игнорируется Git.
TM_ADMIN_TOKEN=ЗАМЕНИТЕ-ДЛИННЫМ-СЛУЧАЙНЫМ-ТОКЕНОМ
TM_DAILY_LOSS_LIMIT=0.03
TM_KILL_SWITCH_DEFAULT=false
TM_DATABASE_URL=postgres://tradingmaster:tradingmaster-local@postgres:5432/tradingmaster?sslmode=disable
TM_PAPER_INITIAL_CAPITAL=10000
TM_PAPER_FEE_BPS=10
TM_PAPER_SLIPPAGE_BPS=5

# Binance Spot Testnet выключен по умолчанию. Адрес production API программно запрещён.
TM_BINANCE_TESTNET_ENABLED=false
TM_BINANCE_TESTNET_ORDER_MODE=validate
TM_BINANCE_TESTNET_RECV_WINDOW_MS=5000
TM_BINANCE_TESTNET_API_KEY=
TM_BINANCE_TESTNET_SECRET_KEY=

# Оставьте оба значения пустыми, чтобы отключить Telegram.
TM_TELEGRAM_BOT_TOKEN=
TM_TELEGRAM_CHAT_ID=
